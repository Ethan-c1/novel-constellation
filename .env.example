# LLM API 配置
# 支持 DeepSeek / Qwen / GPT / SiliconFlow 等兼容 OpenAI 格式的接口
LLM_API_KEY=你的_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# 可选：加速模型（用于提取阶段，留空则使用主模型）
LLM_BOOST_MODEL_NAME=

# 文本分块参数
CHUNK_SIZE=8000
# 必须大于等于 0 且小于 CHUNK_SIZE
CHUNK_OVERLAP=500

# 提取并发数
EXTRACT_MAX_WORKERS=6
# 单个文本块允许模型输出的最大 token 数；关系提取通常 4096 足够
EXTRACT_MAX_TOKENS=4096
# fast=代码聚合（更快）；smart=追加模型聚合（更慢但别名归并更积极）
AGGREGATION_MODE=fast
# 单块临时失败时的重试次数
EXTRACT_MAX_RETRIES=2
# 自动生成的剧情阶段数量上限（1-8）
MAX_STORY_PHASES=6

# 最大上传请求体（字节，默认 12 MiB）
MAX_UPLOAD_BYTES=12582912

# 分析完成/失败后，会话结果在内存中保留的秒数（默认 1 小时）
SESSION_TTL_SECONDS=3600
# 处理中的异常滞留会话最长保留秒数（默认 24 小时）
SESSION_STALE_SECONDS=86400
# 会话清理周期（秒）
SESSION_CLEANUP_INTERVAL=300
